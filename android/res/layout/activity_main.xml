<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical"
    android:background="@color/bg_light" >

    <!-- Top Action Toolbar (Authentic Mail.ru 2010 Blue Header) -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="fill_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/mailru_blue"
        android:paddingLeft="6dp"
        android:paddingRight="6dp" >

        <ImageView
            android:id="@+id/app_logo"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_launcher"
            android:scaleType="fitCenter"
            android:layout_marginRight="6dp" />

        <TextView
            android:id="@+id/header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="&lt;"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/btn_header"
            android:layout_marginLeft="2dp" />

        <Button
            android:id="@+id/btn_forward"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="&gt;"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/btn_header"
            android:layout_marginLeft="2dp" />

        <Button
            android:id="@+id/btn_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="&#8635;"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/btn_header"
            android:layout_marginLeft="2dp" />

        <Button
            android:id="@+id/btn_mode"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:text="ПК"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/btn_header"
            android:layout_marginLeft="2dp" />

    </LinearLayout>

    <!-- Page Load Progress Bar -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="fill_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progress="0"
        android:visibility="gone" />

    <!-- Error / Offline Notice View -->
    <LinearLayout
        android:id="@+id/error_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#fffbe8"
        android:padding="12dp"
        android:visibility="gone" >

        <TextView
            android:id="@+id/error_text"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:textColor="#555555"
            android:textSize="12sp"
            android:text="@string/error_offline" />

        <Button
            android:id="@+id/btn_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_retry"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Main Web Content Container -->
    <WebView
        android:id="@+id/webview"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical" />

</LinearLayout>
