<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allows cleartext HTTP traffic on modern Android 9 to 16 for retro web portals -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">soap.nekxd.fun</domain>
        <domain includeSubdomains="true">nekxd.fun</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
